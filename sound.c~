#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <time.h>
#include <dos.h>
#include <pc.h>

#define SAMPLE_RATE 8000
#define PI 3.1415926535

/*
 *  PWM ENGINE
 */

void playPcm(unsigned char *data, int length) {

  int i;
  unsigned char oPort, pWidth;
  uclock_t nTime;
  int interval = UCLOCKS_PER_SEC / SAMPLE_RATE;

  oPort = inportb(0x61);

  outportb(0x61, oPort | 3);

  outportb(0x43, 0x90);

  nTime =  uClock();

  for (i = 0; i < length; i++) {

    pWidth = (unsigned char)((data[i] * 149) / 255);

    if (pWidth == 0) pWidth = 1;

    outportb(0x42, pWidth);

    nTime += interval;

    while (uclock() < nTime) {

      /*busy*/

    }
    
  }

  outportb(0x61, oPort);

}

int main() {

  int length = SAMPLE_RATE * 2;
  unsigned char *buffer;
  int i;
  float t, wave;

  buffer = (unsigned char *)malloc(length);

  if (!buffer) return 1;

  printf("*******************\n");
  printf("\n");
  printf("  M O O N  E N G\n");
  printf("\n");
  printf(" S O U N D  T E S T\n");
  printf("\n");
  printf("*******************\n");

  printf("** [SYNTH] 440HZ SINE WAVE... **\n");

  for (i = 0; i < length; i++) {

    t = (float)i / SAMPLE_RATE;

    wave = sin(2.0 * PI * 440.0 * t);

    buffer[i] = (unsigned char)((wave + 1.0) * 127.5);
    
  }

  printf("** [PLAYBACK] USING 1-BIT PC SPEAKER PWM...\n **");

  playPcm("** [PLAYBACK] COMPLETE...!\n **");

  free(buffer);

  return 0;
  
 }
