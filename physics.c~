#include <math.h>

#include "defs.h"

void applyPhysics(Player *p) {

  p->a += p->va;

  if (p->a < 0) p->a += 2 * PI;
  if (p->a > 2 * PI) p->a -= 2 * PI;

  p->x += p->vx;

  if (currentMap[(int)(p->y/TIL_SIZE)][(int)(p->x/TIL_SIZE)] != 0) {

    p->x -= p->vx;
    p->vx = 0;
    
  }

  p->y += p->vy;

  if (currentMap[(int)(p->y/TIL_SIZE)][(int)(p->x/TIL_SIZE)] != 0) {

    p->y -= p->vy;
    p->vy = 0;
    
  }

  p->vx *= 0.85;
  p->vy *= 0.85;
  p->va *= 0.70;
  
}
